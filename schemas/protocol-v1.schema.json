{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orion.dev/schemas/protocol-v1.schema.json",
  "title": "Orion native-boundary protocol v1",
  "$defs": {
    "modelRef": {
      "type": "object",
      "required": ["provider", "model"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "toolSpec": {
      "type": "object",
      "required": ["name", "description", "input_schema"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "input_schema": {"type": "object"}
      },
      "additionalProperties": false
    },
    "modelSettings": {
      "type": "object",
      "required": ["temperature", "max_output_tokens", "provider_options"],
      "properties": {
        "temperature": {"type": ["number", "null"]},
        "max_output_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 4294967295},
        "provider_options": {"type": "object"}
      },
      "additionalProperties": false
    },
    "agentSpec": {
      "type": "object",
      "required": ["id", "name", "instructions", "model", "tools", "output_schema", "model_settings", "max_turns"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "instructions": {"type": "string"},
        "model": {"$ref": "#/$defs/modelRef"},
        "tools": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/toolSpec"}},
        "output_schema": {"type": ["object", "null"]},
        "model_settings": {"$ref": "#/$defs/modelSettings"},
        "max_turns": {"type": "integer", "minimum": 1, "maximum": 1024}
      },
      "additionalProperties": false
    },
    "startRun": {
      "type": "object",
      "required": ["run_id", "agent", "input"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "agent": {"$ref": "#/$defs/agentSpec"},
        "input": {"type": "string"}
      },
      "additionalProperties": false
    },
    "toolCall": {
      "type": "object",
      "required": ["id", "name", "arguments"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "arguments": {"type": "object"}
      },
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "required": ["role", "content", "tool_call_id", "tool_calls"],
      "properties": {
        "role": {"enum": ["system", "user", "assistant", "tool"]},
        "content": {"type": "string"},
        "tool_call_id": {"type": ["string", "null"]},
        "tool_calls": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/toolCall"}}
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "modelRequest": {
      "type": "object",
      "required": ["model", "messages", "tools", "output_schema", "settings", "provider_state"],
      "properties": {
        "model": {"$ref": "#/$defs/modelRef"},
        "messages": {"type": "array", "items": {"$ref": "#/$defs/message"}},
        "tools": {"type": "array", "items": {"$ref": "#/$defs/toolSpec"}},
        "output_schema": {"type": ["object", "null"]},
        "settings": {"$ref": "#/$defs/modelSettings"},
        "provider_state": {"type": "object"}
      },
      "additionalProperties": false
    },
    "modelResponse": {
      "type": "object",
      "required": ["content", "tool_calls", "finish_reason", "usage", "provider_state"],
      "properties": {
        "content": {"type": "string"},
        "tool_calls": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/toolCall"}},
        "finish_reason": {"enum": ["stop", "tool_calls", "length", "content_filter", "other"]},
        "usage": {"$ref": "#/$defs/usage"},
        "provider_state": {"type": "object"}
      },
      "additionalProperties": false
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "request"],
          "properties": {"type": {"const": "call_model"}, "request": {"$ref": "#/$defs/modelRequest"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "action_id", "call"],
          "properties": {
            "type": {"const": "execute_tool"},
            "action_id": {"type": "string"},
            "call": {"$ref": "#/$defs/toolCall"}
          },
          "additionalProperties": false
        }
      ]
    },
    "effectResult": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {"type": {"const": "model"}, "value": {"$ref": "#/$defs/modelResponse"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": {"const": "tool"},
            "value": {
              "type": "object",
              "required": ["content"],
              "properties": {"content": true},
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "protocolError": {
      "type": "object",
      "required": ["code", "message", "retryable", "retry_after_ms"],
      "properties": {
        "code": {"enum": ["invalid_command", "invalid_state", "configuration", "authentication", "rate_limited", "timeout", "network", "unsupported_capability", "content_safety", "malformed_response", "provider", "tool", "cancelled", "turn_limit_exceeded"]},
        "message": {"type": "string", "maxLength": 4096},
        "retryable": {"type": "boolean"},
        "retry_after_ms": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "runEvent": {
      "type": "object",
      "required": ["run_id", "sequence", "kind"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 0},
        "kind": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"enum": ["run_started", "model_requested", "model_completed", "tool_requested", "tool_completed", "run_completed", "run_failed", "run_cancelled"]},
            "agent_id": {"type": "string"},
            "turn": {"type": "integer", "minimum": 0},
            "provider": {"type": "string"},
            "model": {"type": "string"},
            "output": {"type": "string"},
            "tool_call_count": {"type": "integer", "minimum": 0},
            "action_id": {"type": "string"},
            "call_id": {"type": "string"},
            "name": {"type": "string"},
            "error": {"$ref": "#/$defs/protocolError"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runResult": {
      "type": "object",
      "required": ["run_id", "output", "usage", "turns"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "output": {"type": "string"},
        "usage": {"$ref": "#/$defs/usage"},
        "turns": {"type": "integer", "minimum": 0, "maximum": 1024}
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["events", "effect", "result"],
      "properties": {
        "events": {"type": "array", "items": {"$ref": "#/$defs/runEvent"}},
        "effect": {"anyOf": [{"$ref": "#/$defs/effect"}, {"type": "null"}]},
        "result": {"anyOf": [{"$ref": "#/$defs/runResult"}, {"type": "null"}]}
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/startRun"},
    {"$ref": "#/$defs/effect"},
    {"$ref": "#/$defs/effectResult"},
    {"$ref": "#/$defs/protocolError"},
    {"$ref": "#/$defs/step"}
  ]
}
